{
  "expo": {
    "name": "My Duit Gw",
    "slug": "my-duit-gw",
    "version": "1.1.12",
    "orientation": "portrait",
    "scheme": "myduitgw",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myduitgw.app"
    },
    "android": {
      "package": "com.myduitgw.app",
      "backgroundColor": "#000000",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "My Duit Gw needs access to your photos so you can attach a transfer receipt.",
          "cameraPermission": "My Duit Gw needs camera access so you can photograph a transfer receipt.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
